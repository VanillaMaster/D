{
    "$schema": "https://raw.githubusercontent.com/vanillamaster/d/main/schema.json",
    "name": "@builtin/proxy",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": null,
        "./server": {
            "import": "./src/server.js"
        },
        "./client": {
            "import": "./src/client.js"
        },

        "./backend": {
            "import": "./src/server.js"
        },
        "./frontend": {
            "import": "./src/client.js"
        }
    },
    "files": [
        "src/**/*"
    ],
    "dependencies": {
        "@builtin/backend": "*",
        "@builtin/compression": "*"
    },
    "devDependencies": {
        "@types/node": "^20.12.12"
    },
    "kind": ["server", "backend"],
    "service.manifest.version": 1
}