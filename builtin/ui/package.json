{
    "$schema": "https://raw.githubusercontent.com/vanillamaster/d/main/schema.json",
    "name": "@builtin/ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": null,
        "./client": {
            "import": "./src/client.js"
        },
        "./frontend": {
            "import": "./src/client.js"
        },

        "./time": {
            "import": "./src/time.js"
        }
    },
    "files": [
        "src/**/*",
        "default/**/*",
        "editable/**/*"
    ],
    "dependencies": {
        "@builtin/lit": "*"
    },
    "devDependencies": {
        "@types/node": "^20.12.12"
    },
    "kind": [
        "client",
        "frontend"
    ],
    "disabled": false,
    "prefetch": [
        "src/*.html"
    ],
    "editable": [
        "src/*.html"
    ],
    "stylesheet": [
        "src/*.css"
    ],
    "service.manifest.version": 1
}